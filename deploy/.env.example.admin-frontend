# Default: local web + hosted Supabase. One env file for all four units is
# deploy/.env.example.local-all → repo-root .env.local + scripts/start-local-web.sh.
# Optional local PG17 template: deploy/.env.example.local-pg17.
# This file is a per-unit fallback only.
# ─── ADMIN SPA (admin-app/frontend/) ────────────────────────────────────
# Copy to admin-app/frontend/.env.local. VITE_* values are PUBLIC and are
# baked into the JS bundle. Never put a secret key, DB password or JWT here.

# Same-origin '/api' uses the local Vite dev proxy. The one-app Cloudflare
# build sets VITE_API_URL=/api/admin and serves both APIs on the same origin.
VITE_API_URL=/api

VITE_PUBLIC_SITE_URL=http://localhost:5173

# Supabase Auth (publishable key is safe in the browser).
VITE_SUPABASE_URL=https://wscpswlfcruheibfyivm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_KEY

# Supabase Storage — public bucket names, no secret key.
VITE_SUPABASE_STORAGE_ENABLED=true
VITE_STORAGE_BUCKET_IMAGES=fenote-images
VITE_STORAGE_BUCKET_VIDEOS=fenote-videos
VITE_STORAGE_BUCKET_DOCUMENTS=fenote-documents

# Supabase Auth URL Configuration: add the local origin and the one-app
# public origin with /admin/** (NOT a separate admin host).
#   http://localhost:5174/**
#   https://YOUR_PUBLIC_DOMAIN/admin/**
# Google OAuth Client ID / Secret are configured ONLY in the Supabase dashboard.
# Never place a service-role key or Google secret in VITE_* values.
