# Default: local web + hosted Supabase. One env file for all four units is
# deploy/.env.example.local-all → repo-root .env.local + scripts/start-local-web.sh.
# Optional local PG17 template: deploy/.env.example.local-pg17.
# This file is a per-unit fallback only.
# ─── ADMIN API (admin-app/backend/) ─────────────────────────────────────
# Copy to admin-app/backend/.env. NEVER commit the real .env.
# No JWT_SECRET, no Resend, no EMAIL_USER/EMAIL_PASSWORD: all identity,
# sessions and password reset are handled by Supabase Auth.

NODE_ENV=development
PORT=5001

# IMPORTANT: the admin API MUST use the SAME database as the public API.
# For the hosted test, set this to your Supabase Postgres connection string.
# Local PG17 fallback: postgresql://postgres:localtest@localhost:5432/fenote_db
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/fenote_db
PG_POOL_MAX=5

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174
ADMIN_URL=https://fenotepsych.com
# Exact admin SPA origin used for /activate and /reset-password links.
# For the one-app Cloudflare build, this is the SAME public origin.
ADMIN_APP_ORIGIN=http://localhost:5174
# One-app Cloudflare build serves the admin SPA under /admin; leave blank or /
# for local root hosting.
ADMIN_APP_BASE_PATH=/
PUBLIC_URL=https://fenotepsych.com
UPLOAD_DIR=/home/user/psychiatrist/admin-app/backend/public/uploads
# STATIC_DIR=/home/user/psychiatrist/admin-app/frontend/dist

# Supabase Auth — publishable values for token verification. The API verifies
# the browser's access token with supabase.auth.getClaims(token).
SUPABASE_URL=https://wscpswlfcruheibfyivm.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_KEY

# SERVER-ONLY secret key used by inviteUserByEmail(). In production put this
# ONLY in the Cloudflare Worker secret store (`wrangler secret put
# SUPABASE_SECRET_KEY`), never in wrangler.jsonc [vars], VITE_*, source, ZIP,
# frontend or chat. Locally use an ignored .env for strict-invite testing.
# Never paste the real value into this example.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Admin authorization is DB-backed via public.admin_profiles.
# The first superadmin is bootstrapped in deploy/supabase/04_storage_and_admin_bootstrap.sql.
# No ADMIN_EMAILS / ADMIN_USER_IDS are used. Public signups are OFF.
