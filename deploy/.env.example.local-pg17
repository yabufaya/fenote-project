# ─── OPTIONAL LEGACY LOCAL PG17 MODE (NOT THE DEFAULT) ───────────────────
# Only for deliberate local PostgreSQL + RLS tests. For local web against
# hosted Supabase, use deploy/.env.example.local-all instead.
# Copy to repo root as .env.local and run:
#   bash scripts/setup-local-db.sh && bash scripts/test-local-rls.sh
# Do NOT run those scripts in hosted-Supabase mode.
# setup-local-db.sh defaults DB_PASS=localtest; set DB_PASS=CHANGE_ME or edit
# this value to match the password you choose.

PUBLIC_API_PORT=5000
ADMIN_API_PORT=5001
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/fenote_db
DATABASE_SSL=false
PG_POOL_MAX=5

# Public API limits per 15-minute window. Reads need headroom for ~15 SPA
# sections plus the shared Realtime/polling fallback; writes stay strict.
PUBLIC_API_READ_MAX=1000
PUBLIC_API_WRITE_MAX=100

PUBLIC_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
ADMIN_APP_ORIGIN=http://localhost:5174
VITE_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

UPLOAD_DIR=./admin-app/backend/public/uploads
# Offline multer fallback only; new runtime files here are ignored by Git.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_KEY

VITE_API_URL=/api
VITE_SUPABASE_STORAGE_ENABLED=false
VITE_STORAGE_BUCKET_IMAGES=fenote-images
VITE_STORAGE_BUCKET_VIDEOS=fenote-videos
VITE_STORAGE_BUCKET_DOCUMENTS=fenote-documents
