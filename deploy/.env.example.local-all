# ─── LOCAL WEB + HOSTED SUPABASE (ONE ENV FOR ALL 4 UNITS) ───────────────
# Copy to the repo root as .env.local (ignored by git):
#   cp deploy/.env.example.local-all .env.local
# Used by server (public API), admin-app/backend (admin API),
# fenote-app (public SPA) and admin-app/frontend (admin SPA).
# All four units run on your machine, but PostgreSQL, Auth, Storage and
# Realtime come from hosted Supabase. No local PostgreSQL is started.
#
# Both Vite configs set envDir to the repo root; both backends load this file
# with dotenv before falling back to any package-local .env.
#
# Replace every YOUR_* / CHANGE_ME placeholder after download.
# VITE_* values are PUBLIC and are baked into browser bundles. Never put a
# service-role key, JWT secret, Google client secret, admin UUID or DB password
# in a VITE_* variable. Never commit the real .env.local.

# Do not put NODE_ENV in this file: Vite must build with NODE_ENV=production,
# while Express uses the host/runtime NODE_ENV (undefined locally, production when deployed).
PUBLIC_API_PORT=5000
ADMIN_API_PORT=5001
# Optional legacy fallback if a host injects only PORT:
# PORT=5000

# Hosted Supabase Postgres DIRECT connection string (not the transaction pooler
# for Hyperdrive). Paste the real value here after download; no local DB.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Hosted Supabase requires TLS. Keep this true; do not append ?sslmode=require.
DATABASE_SSL=true
PG_POOL_MAX=5

# Public API limits per 15-minute window. Reads need headroom for ~15 SPA
# sections plus the shared Realtime/polling fallback; writes stay strict.
PUBLIC_API_READ_MAX=1000
PUBLIC_API_WRITE_MAX=100

PUBLIC_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
ADMIN_APP_ORIGIN=http://localhost:5174
VITE_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174
# If you use Arena/E2B preview, also add:
#   https://YOUR_PUBLIC_PREVIEW_HOST,https://YOUR_ADMIN_PREVIEW_HOST
# The admin SSE stream uses same-origin /api; no cross-origin public API URL is needed.

UPLOAD_DIR=./admin-app/backend/public/uploads
# Legacy /uploads demo + offline multer fallback only. Hosted admin uploads
# go directly to Supabase Storage; new runtime files here are ignored by Git.
# STATIC_DIR=./fenote-app/dist

# Hosted Supabase publishable values. VITE_* copies are PUBLIC and baked into
# browser bundles; never copy a secret key into any VITE_* variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_KEY

# SERVER-ONLY strict-invite key, for local .env.local only. In Cloudflare use
# `wrangler secret put SUPABASE_SECRET_KEY`; never put the real value in
# wrangler.jsonc [vars], this example, Git, a ZIP, or the frontend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Both Vite dev servers proxy /api to their own backend (5000 / 5001).
VITE_API_URL=/api

# Admin SPA: Storage buckets + tokenized SSE stream from the public API.
VITE_SUPABASE_STORAGE_ENABLED=true
VITE_STORAGE_BUCKET_IMAGES=fenote-images
VITE_STORAGE_BUCKET_VIDEOS=fenote-videos
VITE_STORAGE_BUCKET_DOCUMENTS=fenote-documents

# No ADMIN_EMAILS, ADMIN_USER_IDS, JWT_SECRET, Google client secret, DB password
# or real Supabase secret key in Git. Cloudflare secret store only for the latter.
